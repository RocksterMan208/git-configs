{
	"position":"top",
	"modules-left": [
		"hyprland/workspaces",
	],
	
	"modules-center": [
		"hyprland/window",
	],

	"modules-right": [
		"tray",
		"network",
		"pulseaudio",
		"battery",
		"clock",
	],

	"battery": {
		"format": "{icon}    {capacity}%",
		"format-icons": [
			"",
			"",
			"",
			"",
			"",
		],

    		"format-charging": "   {capacity}%"
	},

	"network": {
		"format-wifi": "    {essid}",
	},

	"hyprland/workspaces": {
		"format": "{icon}",
		"format-icons": {
			"active": "󱨇",
			"default": "",
		},

		"persistent-workspaces": {"*": 3,},
	},

	"pulseaudio": {
		"format": "{icon}   {volume}%",
		"format-icons": [
			"",
			"",
			"",
			"",
		],
	}

}
