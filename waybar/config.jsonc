{
	"position":"top",
	"modules-left": [
		"hyprland/workspaces",
	],
	
	"modules-center": [
		"hyprland/window",
	],

	"modules-right": [
		"tray",
		"network",
		"pulseaudio",
		"battery",
		"clock",
	],

	"battery": {
		"format": "{icon}    {capacity}%",
		"format-icons": [
			"",
			"",
			"",
			"",
			"",
		],

    		"format-charging": "   {capacity}%"
	},

	"network": {
		"format-wifi": "{icon}   {essid}",
		"format-disconnected": "󰤭   Not Connected",
		"on-click": "~/.config/waybar/scripts/network.sh",

		"format-icons": [
			"󰤯",
			"󰤟",
			"󰤢",
			"󰤥",
			"󰤨"
		],

		"tooltip": false,
	},

	"hyprland/workspaces": {
		"format": "{icon}",
		"format-icons": {
			"active": "󱨇",
			"default": "",
		},

		"persistent-workspaces": {"*": 3,},
	},

	"pulseaudio": {
		"format": "{icon}   {volume}%",
		"format-icons": [
			"",
			"",
			"",
			"",
		],

		"format-muted": " ",
	},

	"tray": {
		"icon-size" : 16,
		"spacing" : 8,

	},

	"hyprland/window": {
		"max-length": 50,
	},
	
	"clock": {
		"interval": 20,
		"tooltip": true,
		"format": "{:%H:%M}",
		"tooltip-format": "{:%Y-%m-%d}",
	},
}
